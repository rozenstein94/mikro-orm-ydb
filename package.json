{
  "name": "@rozenshtein94/mikro-orm-ydb",
  "version": "0.2.0",
  "description": "Native YQL SQL and core drivers for MikroORM and YDB",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rozenstein94/mikro-orm-ydb.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SQL.md",
    "VERIFICATION.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.17.0"
  },
  "packageManager": "yarn@4.18.1",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "lint": "oxlint src tests --tsconfig tsconfig.json --type-aware --type-check",
    "format": "oxfmt src tests scripts --write",
    "format:check": "oxfmt src tests scripts --check",
    "test": "vitest run",
    "test:integration": "YDB_INTEGRATION=1 vitest run tests/integration.test.ts"
  },
  "peerDependencies": {
    "@mikro-orm/core": "^7.2.9",
    "@mikro-orm/migrations": "^7.2.9",
    "@mikro-orm/sql": "^7.2.9",
    "kysely": "^0.29.8"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.0",
    "@ydbjs/api": "6.0.7",
    "@ydbjs/core": "6.3.1",
    "@ydbjs/error": "6.0.6",
    "@ydbjs/value": "6.0.8"
  },
  "devDependencies": {
    "@mikro-orm/core": "7.2.9",
    "@mikro-orm/migrations": "7.2.9",
    "@mikro-orm/sql": "7.2.9",
    "@types/node": "26.6.6",
    "kysely": "0.29.8",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "^7.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
